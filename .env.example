# Gold Trading Signal Assistant — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Telegram Bot (required for live Telegram alerts)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Protect the public TradingView webhook in production.
# Leave empty for local development only.
WEBHOOK_SECRET=replace_with_a_long_random_secret

# News filter. The current backend validates a news decision supplied
# by the upstream TradingView signal/calendar integration.
NEWS_FILTER_ENABLED=true

# Optional local settings
DEBUG=false
PORT=8000
